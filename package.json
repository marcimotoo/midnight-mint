{
  "name": "midnight-theme-studio",
  "displayName": "Midnight Theme Studio",
  "description": "Dark themes with clear syntax colors, mint accents, and vibrant or soft palettes.",
  "version": "1.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcimotoo/midnight-mint.git"
  },
  "homepage": "https://github.com/marcimotoo/midnight-mint#readme",
  "bugs": {
    "url": "https://github.com/marcimotoo/midnight-mint/issues"
  },
  "scripts": {
    "package": "vsce package --no-dependencies --out ."
  },
  "devDependencies": {
    "@vscode/vsce": "4.0.0"
  },
  "files": [
    "themes/**",
    "images/**",
    "icon.png",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.txt",
    "THIRD-PARTY-NOTICES.txt"
  ],
  "publisher": "marcimoto",
  "license": "SEE LICENSE IN LICENSE.txt",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Midnight Mint",
        "uiTheme": "vs-dark",
        "path": "./themes/midnight-mint-color-theme.json"
      },
      {
        "label": "Midnight Mint Soft",
        "uiTheme": "vs-dark",
        "path": "./themes/midnight-mint-soft-color-theme.json"
      }
    ]
  },
  "icon": "icon.png",
  "keywords": [
    "midnight",
    "theme",
    "color-theme",
    "dark",
    "dark-theme",
    "mint",
    "green",
    "pink",
    "soft",
    "syntax-highlighting",
    "javascript",
    "typescript",
    "python",
    "html",
    "css",
    "json",
    "markdown"
  ],
  "galleryBanner": {
    "theme": "dark",
    "color": "#191d1c"
  }
}
